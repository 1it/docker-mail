driver = sqlite
connect = /var/mail/mail.db
default_pass_scheme = SHA512-CRYPT

password_query = SELECT username as user, password, '/var/mail/%d/%u' as userdb_home, 'maildir:/var/mail/%d/%u' as userdb_mail, 5000 as userdb_uid, 5000 as userdb_gid FROM mailbox WHERE username = '%u' AND active = '1'

user_query = SELECT '/var/mail/%d/%u' as home, 'maildir:/var/mail/%d/%u' as mail, 5000 as uid, 5000 as gid FROM mailbox WHERE username = '%u' AND active = '1'

iterate_query = SELECT username AS user FROM mailbox WHERE active = '1'